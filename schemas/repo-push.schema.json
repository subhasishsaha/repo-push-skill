{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/subhasishsaha/repo-push-skill/main/schemas/repo-push.schema.json",
  "title": "RepoPushConfig",
  "description": "Configuration schema for repo-push repository publishing, platform-specific filtering, and remote pushing.",
  "type": "object",
  "required": ["version", "targets"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Configuration specification version.",
      "type": "string",
      "enum": ["1.0"]
    },
    "require_confirmation": {
      "description": "Whether to pause and require explicit user confirmation before executing git push.",
      "type": "boolean",
      "default": true
    },
    "pre_push": {
      "description": "Pre-push verification and dry-run controls.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_readiness_score": {
          "description": "Minimum adversarial readiness score (0-100) required to unlock remote pushing.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 100
        },
        "dry_run": {
          "description": "Whether to execute a git push --dry-run before actual push.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "targets": {
      "description": "List of remote code hosting publishing targets.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "platform", "url"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Unique identifier for this remote destination (e.g. origin, github, gitlab-mirror).",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "platform": {
            "description": "Target hosting platform.",
            "type": "string",
            "enum": ["github", "gitlab", "huggingface", "bitbucket", "generic"]
          },
          "url": {
            "description": "Git repository remote URL (HTTPS or SSH).",
            "type": "string",
            "pattern": "^(https?://|git@|ssh://)"
          },
          "branch": {
            "description": "Target remote branch to push to.",
            "type": "string",
            "default": "main"
          },
          "push_tags": {
            "description": "Whether to push Git tags with --tags.",
            "type": "boolean",
            "default": false
          },
          "exclude": {
            "description": "List of relative paths or globs to strip on push so platform clutter is never sent.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "metadata": {
            "description": "Platform-specific metadata (e.g. Hugging Face Spaces frontmatter parameters).",
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "title": { "type": "string" },
              "emoji": { "type": "string" },
              "colorFrom": { "type": "string" },
              "colorTo": { "type": "string" },
              "sdk": {
                "type": "string",
                "enum": ["gradio", "streamlit", "docker", "static"]
              },
              "app_file": { "type": "string" },
              "pinned": { "type": "boolean" }
            }
          },
          "lfs_patterns": {
            "description": "File patterns tracked via Git LFS for this remote.",
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    }
  }
}
